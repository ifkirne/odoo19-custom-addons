<!-- ADDED FOR DAY 16: Doctor Weekly Reminder -->
        <record id="ir_cron_doctor_weekly_reminder" model="ir.cron">
            <field name="name">Doctor: Weekly Schedule Reminder</field>
            <field name="model_id" ref="model_hospital_doctor"/>
            <field name="state">code</field>
            <field name="code">model.cron_weekly_doctor_reminder()</field>

            <!-- Configured to run once every 1 week -->
            <field name="interval_number">1</field>
            <field name="interval_type">weeks</field>
            <field name="active" eval="True"/>
        </record>