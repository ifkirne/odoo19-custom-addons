<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================= -->
    <!-- Tree/List View -->
    <!-- ========================= -->
    <record id="view_hospital_doctor_tree" model="ir.ui.view">
        <field name="name">hospital.doctor.tree</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <!-- TASK 5: Apply Decorations - Highlights active/inactive doctors -->
            <list decoration-success="active == True" decoration-muted="active == False">
                <field name="doctor_name"/>
                <field name="employee_id"/>
                <field name="specialization"/>
                <!-- TASK 3: Phone and Email Widgets -->
                <field name="phone" widget="phone"/>
                <field name="email" widget="email"/>
                <field name="experience"/>
                <field name="consultation_fee"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- ========================= -->
    <!-- Form View -->
    <!-- ========================= -->
    <record id="view_hospital_doctor_form" model="ir.ui.view">
        <field name="name">hospital.doctor.form</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <form string="Doctor">
                <header>
                    <button name="action_capitalize_name" string="Update Dr capit Name +1" type="object"
                            class="oe_highlight"
                            confirm="Are you sure you want to capitalize the name and increases experience by 1 ?"/>
                    <button name="action_delete" string="Delete Doctor" type="object" class="btn-danger"
                            confirm="Are you sure you want to delete this Doctor?"/>

                        <button name="%(hospital_management.action_doctor_report)d"
                        string="Print"
                        type="action"
                        class="oe_highlight"/>
                </header>

                <!-- TASK 1: Sheet Layout -->
                <sheet>
                    <!-- TASK 7: Smart Buttons (Must be inside oe_button_box) -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_doctor_patients" type="object" class="oe_stat_button" icon="fa-users">
                            <field name="patient_count" widget="statinfo" string="Patients"/>
                        </button>
                    </div>

                    <!-- PRACTICAL CHALLENGE: Ribbon Widget for Archived Records -->
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active == True"/>

                    <!-- TASK 3: Image Widget -->
                    <field name="image" widget="image" class="oe_avatar"/>

                    <!-- TASK 1: Professional Labels & Title -->
                    <div class="oe_title">
                        <label for="doctor_name" class="oe_edit_only" string="Doctor Name"/>
                        <h1>
                            <field name="doctor_name" placeholder="e.g. Dr. Jane Smith"/>
                        </h1>
                    </div>

                    <group>
                        <group>
                            <!-- TASK 6: Conditional Attributes - Employee ID is readonly if it's already set (id != False) -->
                            <field name="employee_id" readonly="id != False"/>
                            <field name="specialization"/>
                            <field name="department_id" string="Department"/>
                        </group>
                        <group>
                            <!-- TASK 3: Widgets applied -->
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                            <!-- Active field is kept but hidden in form because the Ribbon handles the UI -->
                            <field name="active" invisible="1"/>
                        </group>
                    </group>

                    <!-- TASK 2: Organize Information Using Notebook Pages -->
                    <notebook>
                        <page string="Professional Information" name="professional_info">
                            <group>
                                <group>
                                    <!-- TASK 6: Conditional Attributes - joining date cannot be changed later -->
                                    <field name="joining_date" readonly="id != False"/>
                                    <field name="experience" string="Experience (Years)"/>
                                </group>
                                <group>
                                    <field name="consultation_fee"/>
                                </group>
                            </group>
                        </page>

                        <page string="Assigned Patients" name="assigned_patients">
                            <!-- TASK 1: Direct display of One2many relationships inside a notebook -->
                            <field name="patient_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="age"/>
                                    <field name="state" widget="badge" decoration-info="state == 'admitted'"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

<!-- ========================= -->
    <!-- Search View -->
    <!-- ========================= -->
    <record id="view_hospital_doctor_search" model="ir.ui.view">
        <field name="name">hospital.doctor.search</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <search>
                <!-- Standard Search Fields -->
                <field name="doctor_name"/>
                <field name="employee_id"/>
                <field name="specialization"/>

                <separator/>

                <!-- Basic Filters -->
                <filter string="Active Doctors" name="active_doctors" domain="[('active', '=', True)]"/>
                <filter string="Archived" name="inactive_doctors" domain="[('active', '=', False)]"/>

                <separator/>

                <!-- FIXED: Odoo 19 Group By syntax (No <group> tag wrapper, just the filter directly!) -->
                <filter string="Specialization" name="group_by_specialization" domain="[]" context="{'group_by':'specialization'}"/>
            </search>
        </field>
    </record>

    <!-- ========================= -->
    <!-- Kanban View -->
    <!-- ========================= -->
    <record id="view_hospital_doctor_kanban" model="ir.ui.view">
        <field name="name">hospital.doctor.kanban</field>
        <field name="model">hospital.doctor</field>
        <field name="arch" type="xml">
            <kanban>
                <field name="doctor_name"/>
                <field name="employee_id"/>
                <field name="specialization"/>
                <field name="experience"/>
                <field name="consultation_fee"/>
                <field name="active"/>
                <!-- We must include the image field here if we want it available in the Kanban card later -->
                <field name="image"/>

                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_global_click p-3">
                            <strong class="fs-5">
                                <field name="doctor_name"/>
                            </strong>
                            <div class="mt-2">
                                <div>
                                    <strong>Employee ID:</strong>
                                    <field name="employee_id"/>
                                </div>
                                <div>
                                    <strong>Specialization:</strong>
                                    <field name="specialization"/>
                                </div>
                                <div>
                                    <strong>Experience:</strong>
                                    <field name="experience"/> Years
                                </div>
                                <div>
                                    <strong>Fee:</strong>
                                    <field name="consultation_fee"/>
                                </div>
                                <div class="mt-2">
                                    <t t-if="record.active.raw_value">
                                        <!-- TASK 3: Using badges for status -->
                                        <span class="badge rounded-pill bg-success text-white">Active</span>
                                    </t>
                                    <t t-else="">
                                        <span class="badge rounded-pill bg-danger text-white">Inactive</span>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- ========================= -->
    <!-- Window Action -->
    <!-- ========================= -->
    <record id="action_hospital_doctor" model="ir.actions.act_window">
        <field name="name">Doctors</field>
        <field name="res_model">hospital.doctor</field>
        <field name="view_mode">kanban,list,form</field>
    </record>

</odoo>