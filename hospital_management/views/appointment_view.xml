    <!-- Form View -->
    <!-- Form View -->
    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form>
                <!-- 1. The Header: Adds the pipeline status bar at the top -->
                <header>
                    <!-- widget="statusbar" makes it look like standard Odoo pipelines -->
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,done"/>
                </header>

                <sheet>
                    <group>
                        <group>
                            <field name="patient_id"/>
                            <!-- 2. The Doctor Field: Now you can assign a doctor! -->
<!--                            <field name="doctor_id"/>-->
                            <field name="ref"/>
                            <field name="appointment_time"/>
                        </group>
                        <group>
                            <field name="gender"/>
                            <field name="booking_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- Graph View                                     -->
    <!-- ============================================== -->
    <record id="appointment_graph" model="ir.ui.view">
        <field name="name">hospital.appointment.graph</field> <!-- FIXED -->
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <!-- type can be: "bar", "pie", or "line" -->
            <graph string="Appointment Graph" type="line">
                <field name="patient_id"/>
                <!-- type="measure" defines the numerical value you are calculating -->
                <!--                <field name="amount" type="measure"/>-->
            </graph>
        </field>
    </record>

    <!-- ============================================== -->
    <!-- Pivot View                                     -->
    <!-- ============================================== -->
    <record id="appointment_pivot" model="ir.ui.view">
        <field name="name">hospital.appointment.pivot</field> <!-- FIXED -->
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <pivot string="Appointment Pivot">
                <!-- type="row" puts this field on the vertical axis -->
<!--                <field name="doctor_id" type="row"/>-->


                <!-- type="col" puts this on the horizontal axis.
                     interval="month" is great for grouping datetimes by month -->
                <field name="appointment_time" type="col" interval="day"/>

                <!-- (Optional) Add a measure if you want to calculate something other than "Count" -->
                <!-- <field name="amount" type="measure"/> -->
            </pivot>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.appointment</field>
        <!-- FIXED: Added 'pivot' to the view_mode so the icon shows up in the top right -->
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="search_view_id" ref="view_hospital_appointment_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Appointment!
            </p>
        </field>
    </record>

</odoo>