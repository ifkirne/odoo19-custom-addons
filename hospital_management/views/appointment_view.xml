<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- List/Tree View -->
    <record id="view_hospital_appointment_list" model="ir.ui.view">
        <field name="name">hospital.appointment.list</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <list>
                <field name="patient_id"/>
                <field name="ref"/>
                <field name="gender"/>
                <field name="appointment_time"/>
                <field name="booking_date"/>
                <field name="create_uid" groups="hospital_management.group_hospital_doctors"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_hospital_appointment_form" model="ir.ui.view">
        <field name="name">hospital.appointment.form</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <form>
                <!-- 1. Header Area: Action buttons & Statusbar -->
                <header>
                    <button name="action_send_registration_email"
                            type="object"
                            string="Send Email"
                            class="btn-primary"/>
                    <button name="action_view_sale_order"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-usd"
                            invisible="not sale_order_id">
                        <field name="sale_order_id" widget="statinfo" string="Quotation"/>
                    </button>
                </header>

                <!-- 2. Sheet Area: Stat Box & Record Fields -->
                <sheet>
                    <!-- Stat Button Box inside Sheet -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_sale_order"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-usd">
                            <field name="sale_order_id" widget="statinfo" string="Quotation"/>
                        </button>
                    </div>

                    <group>
                        <group>
                            <field name="patient_id"/>
                            <field name="doctor_id"/>
                            <field name="product_id"/>
                            <field name="partner_id"/>
                            <field name="ref"/>
                            <field name="appointment_time"/>
                        </group>
                        <group>
                            <field name="gender"/>
                            <field name="booking_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Graph View -->
    <record id="appointment_graph" model="ir.ui.view">
        <field name="name">hospital.appointment.graph</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <graph string="Appointment Graph" type="line">
                <field name="patient_id"/>
            </graph>
        </field>
    </record>

    <!-- Pivot View -->
    <record id="appointment_pivot" model="ir.ui.view">
        <field name="name">hospital.appointment.pivot</field>
        <field name="model">hospital.appointment</field>
        <field name="arch" type="xml">
            <pivot string="Appointment Pivot">
                <field name="appointment_time" type="col" interval="day"/>
            </pivot>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_hospital_appointment" model="ir.actions.act_window">
        <field name="name">Appointment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hospital.appointment</field>
        <field name="view_mode">list,form,graph,pivot</field>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Appointment!
            </p>
        </field>
    </record>

</odoo>