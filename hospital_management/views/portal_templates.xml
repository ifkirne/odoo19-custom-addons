<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Task 6: Create Portal Menu -->
    <template id="portal_my_home_menu_appointment" name="Portal layout : appointment menu entries" inherit_id="portal.portal_my_home" priority="20">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Appointments</t>
                <t t-set="url" t-value="'/my/appointments'"/>
                <t t-set="placeholder_count" t-value="'appointment_count'"/>
            </t>
        </xpath>
    </template>

    <!-- Optional: Breadcrumb for navigation -->
    <template id="portal_my_home_appointment_breadcrumbs" name="My Appointments Breadcrumb" inherit_id="portal.portal_breadcrumbs" priority="20">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'appointment'" class="breadcrumb-item active">
                Appointments
            </li>
        </xpath>
    </template>

    <!-- Task 4 & 5: Create Portal Template & Display List -->
    <template id="portal_my_appointments" name="My Appointments">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>

            <t t-call="portal.portal_searchbar">
                <t t-set="title">Appointments</t>
            </t>

            <t t-if="not appointments">
                <div class="alert alert-info mt-4" role="alert">
                    You currently have no scheduled appointments.
                </div>
            </t>

            <t t-if="appointments" t-call="portal.portal_table">
                <thead>
                    <tr>
                        <th>Appointment Number</th>
                        <th>Patient Name</th>
                        <th>Doctor</th>
                        <th>Appointment DateTime</th>
                        <th>Doctor Contact Info</th> <!-- Task 7 -->
                        <th>Notes</th>               <!-- Task 7 -->
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    <t t-foreach="appointments" t-as="appointment">
                        <tr>
                            <td><span t-field="appointment.name"/></td>
                            <td><span t-field="appointment.patient_id.name"/></td>
                            <td><span t-field="appointment.doctor_id.doctor_name"/></td>
                            <td><span t-field="appointment.appointment_time"/></td>

                            <!-- Task 7: Display Appointment Details -->
                            <td>
                                <div t-if="appointment.doctor_id.email">
                                    <i class="fa fa-envelope"/> <span t-field="appointment.doctor_id.email"/>
                                </div>
                                <div t-if="appointment.doctor_id.phone">
                                    <i class="fa fa-phone"/> <span t-field="appointment.doctor_id.phone"/>
                                </div>
                            </td>
                            <td><span t-field="appointment.notes"/></td>

                            <td>
                                <span class="badge rounded-pill text-bg-info" t-field="appointment.state"/>
                            </td>
                        </tr>
                    </t>
                </tbody>
            </t>
        </t>
    </template>

</odoo>