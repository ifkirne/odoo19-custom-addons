<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <template id="hospital_patient_report_template">

        <t t-call="web.html_container">

            <t t-foreach="docs" t-as="doc">

                <t t-call="web.external_layout">

                    <div class="page">

                        <h2>Hospital Patient Report</h2>

                        <p>
                            <strong>Name:</strong>
                            <span t-field="doc.name"/>
                        </p>

                        <p>
                            <strong>Phone:</strong>
                            <span t-field="doc.phone"></span>
                        </p>

                        <p>
                            <strong>Email:</strong>
                            <span t-field="doc.email"></span>
                        </p>


                        <p>
                            <strong>Gender:</strong>
                            <span t-field="doc.gender"></span>
                        </p>


                        <p>
                            <strong>Age:</strong>
                            <span t-field="doc.age"/>
                        </p>

                        <p>
                            <strong>Admission Date:</strong>
                            <span t-field="doc.admission_date"></span>
                        </p>

                    </div>

                </t>

            </t>

        </t>

    </template>

</odoo>