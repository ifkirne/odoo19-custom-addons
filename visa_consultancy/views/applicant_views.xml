<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_visa_applicant_list" model="ir.ui.view">
        <field name="name">visa.applicant.list</field>
        <field name="model">visa.applicant</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="passport_number"/>
                <field name="nationality"/>
                <field name="phone"/>
            </list>
        </field>
    </record>

    <record id="view_visa_applicant_form" model="ir.ui.view">
        <field name="name">visa.applicant.form</field>
        <field name="model">visa.applicant</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="passport_number"/>
                        <field name="nationality"/>
                    </group>
                    <group>
                        <field name="date_of_birth"/>
                        <field name="gender"/>
                    </group>
                    <group>
                        <field name="phone"/>
                        <field name="email"/>
                    </group>
                    <field name="address"/>
                    <field name="notes"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>