<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_visa_country_list" model="ir.ui.view">
        <field name="name">visa.country.list</field>
        <field name="model">visa.country</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_visa_country_form" model="ir.ui.view">
        <field name="name">visa.country.form</field>
        <field name="model">visa.country</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                        <field name="active"/>
                    </group>
                    <field name="description"/>
                </sheet>
            </form>
        </field>
    </record>
</odoo>